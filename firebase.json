{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "render.yaml",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "scripts/**"
    ],
    "redirects": [
      { "source": "/service-lms", "destination": "/service-si.html", "type": 301 },
      { "source": "/service-lms.html", "destination": "/service-si.html", "type": 301 },
      { "source": "/service-api", "destination": "/service-si.html", "type": 301 },
      { "source": "/service-api.html", "destination": "/service-si.html", "type": 301 },
      { "source": "/service-accounting", "destination": "/service-beequest.html", "type": 301 },
      { "source": "/service-accounting.html", "destination": "/service-beequest.html", "type": 301 },
      { "source": "/service-ax", "destination": "/service-partners.html", "type": 301 },
      { "source": "/service-ax.html", "destination": "/service-partners.html", "type": 301 }
    ],
    "rewrites": [
      { "source": "/company", "destination": "/company.html" },
      { "source": "/contact", "destination": "/contact.html" },
      { "source": "/faq", "destination": "/faq.html" },
      { "source": "/service-partners", "destination": "/service-partners.html" },
      { "source": "/service-beequest", "destination": "/service-beequest.html" },
      { "source": "/service-si", "destination": "/service-si.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ]
  }
}
